rules_version = '2';
// Firebase 콘솔 > Firestore > 규칙에 그대로 붙여 넣는다.
// webPush: 웹앱 새 공지 알림 구독(web/app.js setPush).
// - 누구도 목록을 읽을 수 없다(읽기는 서버의 서비스 계정만 — 규칙을 거치지 않는다).
// - 자기 토큰 문서만 만들고 고칠 수 있다: 문서 id = 토큰, 칸은 token·boards·updated뿐, 게시판 60개까지.
service cloud.firestore {
  match /databases/{database}/documents {
    match /webPush/{token} {
      allow read: if false;
      allow create, update: if token.size() < 500
        && request.resource.data.keys().hasOnly(['token', 'boards', 'updated'])
        && request.resource.data.token == token
        && request.resource.data.boards is list
        && request.resource.data.boards.size() <= 60
        && request.resource.data.updated is int;
      allow delete: if true;  // 토큰을 아는 쪽(그 브라우저)만 지울 수 있다
    }
    // stats: 사용자 수·다운로드 수(앱 UsageStats.kt, 웹 download/). 숫자 칸 하나를 +1 하는 것만 허용.
    // 누구나 읽을 수 있다(버전별 숫자뿐이라 감출 것이 없다).
    function statsDoc(doc) {
      return doc in ['devices', 'downloads'] || doc.matches('d[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }
    match /stats/{doc} {
      allow get, list: if true;
      allow create: if statsDoc(doc)
        && request.resource.data.size() == 1
        && request.resource.data.keys()[0].matches('v[0-9_]{1,20}')
        && request.resource.data.values()[0] == 1;
      // 칸 하나만 바뀌는 것만. 규칙 언어의 Set에는 toList()가 없어서 바뀐 칸의 값을 집어 +1인지 볼 수 없다
      // (2026-10-06까지 그렇게 써서 모든 갱신이 거부됐다 — 문서를 처음 만든 1회만 세졌다). 대략적인 추세용이라 감수.
      allow update: if statsDoc(doc)
        && request.resource.data.size() <= 200
        && request.resource.data.diff(resource.data).affectedKeys().size() == 1
        && request.resource.data.diff(resource.data).removedKeys().size() == 0;
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
